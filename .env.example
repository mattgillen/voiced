# Copy to .env for local runs (`cp .env.example .env`); .env is gitignored and loaded
# by npm start, npm run mcp, sim and eval. Real environment variables win over .env.
# In a Claude Code cloud session, set these in the environment's settings instead.

# --- Brain: which model decides at each prompt. Unset = rules only (free, offline).
# Free Gemini key: https://aistudio.google.com/apikey
# Free-tier caveat: Google may use free-tier prompts and responses to improve its
# products. Secrets never reach the model, but names, ZIPs and transcripts do, so
# use a paid key for anyone else's calls.
GEMINI_API_KEY=
# VOICED_GEMINI_MODEL=gemini-flash-lite-latest   # free tier: full Flash models allow ~20 requests/day; Flash-Lite runs the eval
# VOICED_GEMINI_THINKING=low          # "low"/"high" (thinkingLevel) or a number (thinkingBudget)
# ANTHROPIC_API_KEY=                  # Claude brain; wins over Gemini when both are set
# VOICED_MODEL=claude-opus-5
# VOICED_BRAIN=gemini                 # force one: rules | gemini | claude

# --- Real calls (Twilio ConversationRelay). All four plus an https PUBLIC_URL turn them on.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=
# TWILIO_NUMBER=+1...                 # your Twilio number (caller ID)
# VOICED_USER_PHONE=+1...             # your phone, for the warm handoff
# PUBLIC_URL=https://...              # e.g. a Cloudflare tunnel to localhost:8787
# VOICED_ALLOWED_NUMBERS=+13155550110 # business lines real calls may dial
# VOICED_RECORD=1                     # record real calls (paused while vault digits are keyed)

# --- Twilio's own MCP server (.mcp.json), for setting up numbers and reading call logs.
# An API key pair from Console > Account > API keys, revocable on its own.
# TWILIO_API_KEY=SK...
# TWILIO_API_SECRET=

# --- Server
# PORT=8787
# VOICED_API_KEY=vk_demo_local        # change it anywhere public
# VOICED_OPERATOR=scripted            # or manual, for real people on the operator API
# VOICED_OPERATOR_KEY=vo_demo_local
